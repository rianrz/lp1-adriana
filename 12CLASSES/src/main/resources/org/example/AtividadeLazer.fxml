<?import javafx.scene.layout.AnchorPane?>


<AnchorPane prefHeight="600.0" prefWidth="625.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.AtividadeLazerController">
   <children>
      <Button layoutX="461.0" layoutY="379.0" mnemonicParsing="false" onAction="#voltar" text="Voltar" />
