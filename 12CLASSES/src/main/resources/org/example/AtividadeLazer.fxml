      <TextField fx:id="txt_duracao" layoutX="60.0" layoutY="187.0" />
      <TextField fx:id="txt_nivel" layoutX="60.0" layoutY="275.0" />
      <TextField fx:id="txt_parada" layoutX="60.0" layoutY="367.0" />
      <Label layoutX="60.0" layoutY="73.0" text="Nome da Atividade" />
      <Label layoutX="60.0" layoutY="159.0" text="Duração em Minutos" />
