         </font>
      </Button>
      <TextField fx:id="txt_senha" layoutX="138.0" layoutY="156.0" prefHeight="99.0" prefWidth="263.0" promptText="insira o texto">
         <font>
            <Font size="36.0" />
         </font>
      </TextField>
      <Label layoutX="228.0" layoutY="111.0" text="Insira a Senha" />
      <Label fx:id="acesso" layoutX="255.0" layoutY="325.0" text="...." />
      <Button layoutX="92.0" layoutY="335.0" mnemonicParsing="false" onAction="#Voltar" text="Voltar" />
   </children>
</AnchorPane>
