   <children>
      <Label layoutX="45.0" layoutY="40.0" text="Informe a distancia" />
      <Label layoutX="45.0" layoutY="129.0" text="Informe o preço" />
      <TextField fx:id="txt_distancia" layoutX="45.0" layoutY="70.0" />
      <TextField fx:id="txt_preco" layoutX="46.0" layoutY="166.0" />
      <Button layoutX="361.0" layoutY="116.0" mnemonicParsing="false" onAction="#calcular" text="Calcular" />
      <Label fx:id="lbl_result" layoutX="267.0" layoutY="252.0" text="..." />
      <Button layoutX="92.0" layoutY="335.0" mnemonicParsing="false" onAction="#Voltar" text="Voltar" />
   </children>
</AnchorPane>
